# Copy to `.env` and adjust. `.env` is git-ignored.
# The example app has its own template: sdk-example/.env.example

# --- sdk-example ---------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost/supra_indexer_example
SUPRA_RPC_URL=https://rpc-testnet.supra.com
CONTRACT_ADDRESS=0xa802ca2e7a6604e8a4cc3ef390bc137767b0cb04438525b0a3451e0bbd410ddf
START_BLOCK=135000000
# FORCE_START_BLOCK=true      # rewind every event to START_BLOCK on startup
HTTP_ADDR=0.0.0.0:8080
# ADMIN_TOKEN=change-me       # enables POST /admin/{pause,resume,shutdown}
RUST_LOG=info,supra_indexer_sdk=info

# --- tests ---------------------------------------------------------------
# PostgreSQL end-to-end tests run only when this is set.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost/supra_indexer_sdk_test

# --- benchmarks (examples/perf_bench) -------------------------------------
# Database name must contain "perf" or "test": scenarios TRUNCATE their tables.
PERF_DATABASE_URL=postgres://postgres:postgres@localhost/supra_indexer_sdk_perf
# `live` scenario: blocks to catch up over against the real RPC.
LIVE_SPAN_BLOCKS=1000000
